# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zoom_bots
DB_USER=postgres
DB_PASSWORD=your_password_here

# API Server Configuration
PORT=3000

# Bot Server Configuration (for bot-server/api.js)
BOT_SERVER_PORT=3001
SERVER_CAPACITY=100

# Zoom API Credentials (for bot creation)
ZOOM_ACCOUNT_ID=your_account_id
ZOOM_CLIENT_ID=your_client_id
ZOOM_CLIENT_SECRET=your_client_secret

# ZAK Pre-generate (Profile Pic): bot-server refreshes ZAK to zak-token.env
# ZAK_REFRESH_INTERVAL_MINUTES=5   # Local testing: every 5 min (default 120 = 2h)
# Option A - User OAuth (recommended, fixes error 2300): Create OAuth 2.0 app, do OAuth flow once for bot user
ZOOM_REFRESH_TOKEN=
# Multiple profile pics: comma-separated or ZOOM_REFRESH_TOKENS_FILE=path
# ZOOM_REFRESH_TOKENS=token1,token2,token3
# ZOOM_REFRESH_TOKENS_FILE=profile-pics/refresh-tokens.txt
# Multi-ZAK: by default uses S2S + users.txt when available. To force 1 ZAK (refresh only):
# ZAK_USE_REFRESH_ONLY=1
# ZAK_MAX_BOTS=50
