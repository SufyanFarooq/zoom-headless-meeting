FROM node:18-alpine

WORKDIR /app

# Install Docker CLI, docker-compose, bash, and python3 (for bot server to manage containers and run scripts)
# Download docker-compose binary directly
RUN apk add --no-cache docker-cli bash curl python3 py3-pip && \
    curl -L "https://github.com/docker/compose/releases/download/v2.24.0/docker-compose-linux-x86_64" -o /usr/local/bin/docker-compose && \
    chmod +x /usr/local/bin/docker-compose

# Copy package files
COPY package.json ./

# Install dependencies
RUN npm install --only=production

# Copy bot server code
COPY bot-server/ ./bot-server/

# Expose port
EXPOSE 3001

# Start bot server API
CMD ["node", "bot-server/api.js"]

